{
 "version": 1,
 "params": [
  {
   "path": "disease.model",
   "module": "disease",
   "label": "Model",
   "description": "Which compartments the disease has: sir, seir (latent period), sis (no lasting immunity), sirs and seirs (immunity wanes), seiar (an asymptomatic track).",
   "kind": "enum",
   "unit": null,
   "default": "sir",
   "bounds": null,
   "choices": [
    "sir",
    "seir",
    "sis",
    "sirs",
    "seirs",
    "seiar"
   ],
   "models": [],
   "tier": "core",
   "db_field": null,
   "starsim_target": "ss.SIR, ss.SEIR, ss.SIS and the EpiChat subclasses in epichat/sim/models.py",
   "affects": [
    "timing",
    "peak",
    "final_size",
    "deaths",
    "duration",
    "endemicity",
    "stochasticity"
   ],
   "requires": []
  },
  {
   "path": "disease.beta",
   "module": "disease",
   "label": "Transmission rate",
   "description": "Per-contact transmission rate per year; the configure tool sets it from R0. Starsim turns it into a daily probability 1 - exp(-beta / 365).",
   "kind": "number",
   "unit": "per year",
   "default": 22.8125,
   "bounds": [
    0.001,
    1000.0
   ],
   "choices": null,
   "models": [],
   "tier": "advanced",
   "db_field": null,
   "starsim_target": "disease.pars.beta = ss.peryear(beta)",
   "affects": [
    "peak",
    "final_size"
   ],
   "requires": []
  },
  {
   "path": "disease.dur_exp.mean_days",
   "module": "disease",
   "label": "Latent period (mean)",
   "description": "Days between infection and becoming infectious. Required for seir, seirs and seiar; the database incubation period is the usual source.",
   "kind": "number",
   "unit": "days",
   "default": null,
   "bounds": [
    0.1,
    1000.0
   ],
   "choices": null,
   "models": [
    "seir",
    "seirs",
    "seiar"
   ],
   "tier": "core",
   "db_field": "incubation_days",
   "starsim_target": "ss.SEIR(dur_exp=...)",
   "affects": [
    "timing"
   ],
   "requires": []
  },
  {
   "path": "disease.dur_exp.dist",
   "module": "disease",
   "label": "Latent period (distribution)",
   "description": "How the period varies between people: constant (everyone the same), gamma or lognormal (needs sd_days). Migrated scenarios are constant; new scenarios use gamma with an illustrative sd.",
   "kind": "enum",
   "unit": null,
   "default": "constant",
   "bounds": null,
   "choices": [
    "constant",
    "lognormal",
    "gamma"
   ],
   "models": [
    "seir",
    "seirs",
    "seiar"
   ],
   "tier": "advanced",
   "db_field": null,
