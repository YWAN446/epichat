    "disease.dur_exp.sd_days"
   ]
  },
  {
   "path": "disease.dur_exp.sd_days",
   "module": "disease",
   "label": "Latent period (sd)",
   "description": "Standard deviation of the period between people, in days; at most twice the mean. Realized periods are about half a day longer than configured because transitions happen on whole days.",
