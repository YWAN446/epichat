  {
   "path": "disease.p_death",
   "module": "disease",
   "label": "Case fatality ratio",
   "description": "Share of cases that die at the end of the infectious period. In seiar only symptomatic infections are cases; in the other models every infection is, so a surveillance CFR overstates deaths for diseases with many mild or unreported infections. Surveillance CFRs also carry their own biases.",
   "kind": "number",
   "unit": "fraction",
   "default": 0.0,
   "bounds": [
    0.0,
    1.0
   ],
   "choices": null,
   "models": [
    "sir",
    "seir",
    "sirs",
    "seirs",
    "seiar"
   ],
   "tier": "core",
   "db_field": "fatality_rate",
   "starsim_target": "ss.bernoulli(p=p_death) drawn at infection",
   "affects": [
    "deaths"
   ],
   "requires": []
  },
  {
   "path": "disease.p_asymp",
   "module": "disease",
   "label": "Asymptomatic share",
   "description": "Share of infections that never show symptoms; they still transmit, at rel_trans_asymp of a symptomatic case, and never die of the disease.",
   "kind": "number",
   "unit": "fraction",
   "default": 0.3,
   "bounds": [
    0.0,
    1.0
   ],
   "choices": null,
   "models": [
    "seiar"
   ],
   "tier": "core",
   "db_field": "asymptomatic_fraction",
   "starsim_target": "SEIAR p_asymp = ss.bernoulli(p=...)",
   "affects": [
    "peak",
    "final_size"
   ],
   "requires": []
  },
  {
   "path": "disease.rel_trans_asymp",
