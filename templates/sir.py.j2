import starsim as ss
import matplotlib
matplotlib.use('Agg')
import json
import numpy as np

# ── Disease parameters ────────────────────────────────────────────────────────
disease_pars = dict(
    type='sir',
    init_prev={{ init_prev }},
    beta={{ beta }},
    dur_inf=ss.constant({{ dur_inf }}),
    p_death={{ p_death }},
)

# ── Interventions (non-vaccine) ───────────────────────────────────────────────
interventions_list = []
connectors_list = []

{% if seasonality_int %}
connectors_list.append(ss.seasonality(
    diseases='sir',
    scale={{ seasonality_int.scale }},
    shift={{ seasonality_int.shift }},
))
{% endif %}

{% if treatment_int %}
from starsim.interventions import treat_num as _treat_num
_tx = ss.Tx()
_treatment = _treat_num(
    product=_tx,
    prob={{ treatment_int.coverage if treatment_int.coverage is not none else 1.0 }},
    {% if treatment_int.capacity is not none %}max_capacity={{ treatment_int.capacity }},{% endif %}
)
interventions_list.append(_treatment)
{% endif %}

{% if vaccine and vaccine.start_day > 0 %}
# ── Ongoing vaccination campaign (starts day {{ vaccine.start_day }}) ─────────
_product = ss.simple_vx(efficacy=1.0)
_vax_start_year = 2000 + {{ vaccine.start_day }} / 365
interventions_list.append(ss.routine_vx(
    product=_product,
    prob={{ vaccine.coverage }},
    start_year=_vax_start_year,
))
{% endif %}

# ── Network ───────────────────────────────────────────────────────────────────
{% if network_type == 'age_structured' %}
# POLYMOD-inspired age-structured contact network (children 0-17 / adults 18-64 / elderly 65+)
_age_groups = {
    'children': ss.AgeGroup(0, 18),
    'adults':   ss.AgeGroup(18, 65),
    'elderly':  ss.AgeGroup(65, None),
}
_contact_matrix = np.array([
    [7.0, 2.5, 0.5],
    [2.5, 9.0, 1.5],
    [0.5, 1.5, 3.5],
]) * {{ network_beta }}
_network = ss.MixingPools(diseases='sir', src=_age_groups, dst=_age_groups,
                          n_contacts=_contact_matrix, beta=1.0)
{% else %}
_network = dict(type='random', n_contacts={{ n_contacts }}, beta={{ network_beta }})
{% endif %}

# ── Simulation parameters ─────────────────────────────────────────────────────
pars = dict(
    n_agents={{ n_agents }},
    networks=_network,
    diseases=disease_pars,
{% if use_demographics %}
    demographics=[
        ss.Births(birth_rate={{ birth_rate }}),
        ss.Deaths(death_rate={{ death_rate }}),
    ],
{% endif %}
    dur={{ sim_dur_years }},
    dt=1/365,
{% if rand_seed is not none %}
    rand_seed={{ rand_seed }},
{% endif %}
)

if interventions_list:
    pars['interventions'] = interventions_list

sim = ss.Sim(pars, connectors=connectors_list or None, verbose=0)
sim.init()

{% if vaccine and vaccine.start_day <= 0 %}
_sir = sim.diseases['sir']
_sus = _sir.susceptible.uids
_n_vax = int({{ vaccine.coverage }} * len(_sus))
{% if rand_seed is not none %}
_rng = np.random.default_rng({{ rand_seed }})
{% else %}
_rng = np.random.default_rng()
{% endif %}
_vax_uids = _rng.choice(_sus, size=_n_vax, replace=False) if _n_vax > 0 else np.array([], dtype=int)
_sir.susceptible[_vax_uids] = False
_sir.recovered[_vax_uids] = True
{% endif %}

{% if age_pct_under18 is not none and network_type == 'age_structured' %}
_n = len(sim.people)
_n_c = round({{ age_pct_under18 }} / 100 * _n)
_n_e = round({{ age_pct_over65  }} / 100 * _n)
_n_a = max(0, _n - _n_c - _n_e)
{% if rand_seed is not none %}
_rng_age = np.random.default_rng({{ rand_seed }} + 1)
{% else %}
_rng_age = np.random.default_rng()
{% endif %}
_ages = np.concatenate([
    _rng_age.uniform(0, 18, _n_c),
    _rng_age.uniform(18, 65, _n_a),
    _rng_age.uniform(65, 95, _n_e),
])
_rng_age.shuffle(_ages)
sim.people.age[:] = _ages[:_n]
{% endif %}

sim.run()

res = sim.results
dr = res[list(sim.diseases.keys())[0]]

n_infected     = dr['n_infected'].values
cum_infections = dr['cum_infections'].values
cum_deaths     = res['cum_deaths'].values

import matplotlib.pyplot as plt
_days = np.arange(len(n_infected))
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4))
for _key, _color, _lbl in [
    ('n_susceptible', 'steelblue', 'Susceptible'),
    ('n_infected',    'firebrick', 'Infectious'),
    ('n_recovered',   'seagreen',  'Recovered'),
]:
    if _key in dr:
        ax1.plot(_days, dr[_key].values, color=_color, label=_lbl)
ax1.set_xlabel('Day')
ax1.set_ylabel('Count')
ax1.set_title('SIR Compartments')
ax1.legend()
ax2.plot(_days, cum_infections, color='steelblue', label='Cumulative infections')
ax2.plot(_days, cum_deaths,     color='firebrick', label='Cumulative deaths')
ax2.set_xlabel('Day')
ax2.set_ylabel('Count')
ax2.set_title('Cumulative')
ax2.legend()
fig.tight_layout()
fig.savefig(r'{{ output_path }}', dpi=150, bbox_inches='tight')
plt.close(fig)

print(json.dumps({
    'peak_infections': int(n_infected.max()),
    'peak_day':        int(n_infected.argmax()),
    'total_infected':  int(cum_infections[-1]),
    'total_deaths':    int(cum_deaths[-1]),
    'n_agents':        {{ n_agents }},
    'sim_days':        len(res['timevec']),
}))
